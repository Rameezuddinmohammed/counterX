# Copy to .env and replace local-only placeholders. Never commit .env or real secrets.

# Shared typed runtime configuration
NODE_ENV=development
COUNTER_ENV=local
LOG_LEVEL=info

# Local PostgreSQL bootstrap/migration owner (persistent Docker volume, loopback only).
# Never use this SUPERUSER credential for scoped application runtime access.
COUNTER_LOCAL_DB_USER=counter_local
COUNTER_LOCAL_DB_PASSWORD=replace-with-local-only-password
COUNTER_LOCAL_DB_PORT=5432
DATABASE_URL=postgresql://counter_local:replace-with-local-only-password@localhost:5432/counter_local

# Test PostgreSQL bootstrap/migration owner (ephemeral Docker tmpfs, separate database/port).
# The RLS suite creates and tests through a separate restricted temporary runtime role.
COUNTER_TEST_DB_USER=counter_test
COUNTER_TEST_DB_PASSWORD=replace-with-test-only-password
COUNTER_TEST_DB_PORT=5433
TEST_DATABASE_URL=postgresql://counter_test:replace-with-test-only-password@localhost:5433/counter_test

# Restore validation intentionally targets the isolated test database, never local data.
RESTORE_DATABASE_URL=postgresql://counter_test:replace-with-test-only-password@localhost:5433/counter_test

# Optional local PostgreSQL client binary directory for backup/restore.
# PG_BIN_DIR=C:\Program Files\PostgreSQL\17\bin

# apps/control-plane-api
CONTROL_PLANE_API_PORT=4000

# apps/agent-runtime
AGENT_RUNTIME_PORT=4100

# apps/worker
WORKER_CONCURRENCY=4

# apps/merchant-console
MERCHANT_CONSOLE_PORT=3000
MERCHANT_CONSOLE_API_BASE_URL=http://localhost:4000

# apps/wallet-console
WALLET_CONSOLE_PORT=3001
WALLET_CONSOLE_API_BASE_URL=http://localhost:4000

# apps/operations-console
OPERATIONS_CONSOLE_PORT=3002
OPERATIONS_CONSOLE_API_BASE_URL=http://localhost:4000

# apps/local-mcp
LOCAL_MCP_PORT=4200

# apps/reference-buyer
REFERENCE_BUYER_PORT=4300

# apps/reference-services
REFERENCE_SERVICES_PORT=4400

# Optional OpenTelemetry collector (docker compose --profile telemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
