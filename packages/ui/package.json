{
  "name": "@counter/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Counter Platform shared UI component library - shadcn/ui-style components with Counter brand design system",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/styles/globals.css"
  },
