{
  "name": "@counter/reference-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Generic REST reference connector for contract testing and certification.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
