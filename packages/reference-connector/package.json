    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@counter/connector-sdk": "workspace:0.1.0",
    "@counter/domain": "workspace:0.1.0"
  },
  "devDependencies": {
    "fast-check": "4.0.0",
    "typescript": "5.7.3",
    "vitest": "3.0.7"
  }
}
