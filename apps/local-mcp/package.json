{
  "name": "@counter/local-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP tool server and signer boundary. Enforces a hard denylist for policy/key/payment-secret mutation tools.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "register-buyer-agent": "node scripts/register-buyer-agent.mjs",
    "register-agent-self-serve": "node scripts/register-agent-self-serve.mjs",
    "start:real": "node dist/main-real.js"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "3.0.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@counter/wallet-domain": "workspace:*",
    "@counter/wallet-application": "workspace:*",
    "@counter/wallet-contracts": "workspace:*",
    "@counter/payment-sdk": "workspace:*",
    "@counter/evidence": "workspace:*",
    "@counter/trust-protocol": "workspace:*",
    "@counter/merchant-contracts": "workspace:*",
    "@counter/domain": "workspace:*",
    "@counter/data": "workspace:*",
    "zod": "3.25.76"
  }
}
