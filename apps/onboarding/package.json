{
  "name": "@counter/onboarding",
  "version": "0.1.0",
  "private": true,
  "description": "Public signup/login site: turns a real login into a real wallet and a one-command local AI connection. Test-mode money throughout.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3100",
    "start": "next start --port 3100",
