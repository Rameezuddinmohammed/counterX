{
  "name": "@counter/remote-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server (Streamable HTTP) fronted by a real OAuth 2.1 authorization server that two-leg proxies Counter's Auth0 tenant, so DCR-only MCP clients can connect.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@counter/authorization": "workspace:0.1.0",
    "@counter/data": "workspace:0.1.0",
    "@counter/domain": "workspace:0.1.0",
    "@counter/http-api-kit": "workspace:0.1.0",
    "@counter/local-mcp": "workspace:0.1.0",
    "@counter/wallet-application": "workspace:0.1.0",
    "@counter/wallet-domain": "workspace:0.1.0",
    "@fastify/express": "4.0.7",
    "@modelcontextprotocol/sdk": "1.30.0",
    "fastify": "5.2.1",
    "jose": "6.0.11"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "typescript": "5.7.3",
    "vitest": "3.0.7"
  }
}
